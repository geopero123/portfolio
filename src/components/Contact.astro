---
import { SITE, contactLinks } from '../site.config';
import Icon from './Icon.astro';
import SectionIndex from './SectionIndex.astro';
// Only channels with an approved value render (see site.config.ts). The big arrow goes to the
// most direct one available: email, then LinkedIn, then GitHub.
const links = contactLinks();
const primary = links[0];
const lead = primary.kind === 'email' ? 'Email is quickest.' : primary.kind === 'linkedin' ? 'LinkedIn is quickest.' : 'GitHub is the best place to reach me and see the code.';
---
<section id="contact" class="contact-section" aria-labelledby="contact-title">
  <div class="shell contact-inner">
    <p class="eyebrow" data-m="slide"><SectionIndex n="05" /> Contact</p>
    <div class="contact-heading">
      <h2 id="contact-title" data-m="mask" data-velocity><span class="line-mask"><span style="--i:0">Hiring for React</span></span><span class="line-mask"><span class="serif" style="--i:1">or frontend?</span></span></h2>
      <a class="contact-arrow" href={primary.href} {...(primary.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})} aria-label={`Contact Giorgi via ${primary.label}`} data-magnetic data-m="scale" style="--delay:300ms"><Icon /></a>
    </div>
    <div class="contact-bottom">
      <span class="contact-rule" data-m="draw" aria-hidden="true"></span>
      <div class="contact-intro" data-m="clip" style="--delay:200ms">
        <p>I'd like to hear about the role. {lead}</p>
        <p>Fully remote from Tbilisi. I work in writing: email or chat.</p>
      </div>
      <ul class="contact-list" aria-label="Ways to reach Giorgi">
        {links.map(l => (
          <li class:list={{ 'contact-email-row': l.kind === 'email' }}>
            <a class="contact-link" href={l.href} {...(l.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}><span class="mono">{l.label}</span><span class="contact-value">{l.value}</span><Icon /></a>
            {l.kind === 'email' && <>
              <button class="copy-email mono" type="button" data-copy-email={SITE.socials.email} data-enhancement hidden aria-label="Copy email">
                <span class="copy-labels" aria-hidden="true">
                  <span data-copy-label>Copy email</span>
                  <span class="copy-confirmation"><svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="m3 8 3 3 7-7" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg> Copied</span>
                </span>
              </button>
              <span class="sr-only" role="status" data-copy-status></span>
            </>}
          </li>
        ))}
        {SITE.resume && <li><a class="contact-link" href={SITE.resume} target="_blank" rel="noopener"><span class="mono">Résumé</span><span class="contact-value">PDF</span><Icon /></a></li>}
      </ul>
    </div>
  </div>
</section>

<style>
  .contact-intro p + p { margin-top: 8px; }
  .contact-email-row { display: flex; align-items: center; gap: 12px; border-bottom: 1px solid #555c4130; }
  .contact-email-row .contact-value { white-space: nowrap; }
  .contact-email-row .contact-link { flex: 1; min-width: 0; border-bottom: 0; }
  .copy-email {
    flex-shrink: 0;
    min-width: 84px;
    min-height: 44px;
    padding-inline: 9px;
    border: 1px solid #555c4159;
    border-radius: 4px;
    color: #30382a;
    background: transparent;
  }
  .copy-labels { display: grid; place-items: center; white-space: nowrap; }
  .copy-labels > span { grid-area: 1 / 1; }
  .copy-confirmation { display: inline-flex; align-items: center; gap: 4px; opacity: 0; }
  .copy-confirmation svg { width: 12px; height: 12px; }
  .copy-email[data-copy-state="copied"] .copy-confirmation { opacity: 1; }
  .copy-email[data-copy-state="copied"] [data-copy-label] { opacity: 0; }
  @media (prefers-reduced-motion: no-preference) {
    .copy-labels > span { transition: opacity 160ms ease-out; }
  }
  .copy-email:hover { background: #555c411a; }

  @media (max-width: 760px) {
    .contact-email-row { display: block; }
    .copy-email { display: block; margin: 0 0 4px 54px; }
    :global(.js) .contact-email-row:has(.copy-email[hidden]) { padding-bottom: 48px; }
  }
</style>

<script>
  function initCopyEmail() {
    const button = document.querySelector<HTMLButtonElement>('[data-copy-email]');
    if (!button || button.dataset.ready) return;
    button.dataset.ready = '1';
    const status = document.querySelector<HTMLElement>('[data-copy-status]');
    const label = button.querySelector<HTMLElement>('[data-copy-label]')!;
    const setLabel = (value: string) => {
      button.setAttribute('aria-label', value);
      button.dataset.copyState = value === 'Copied' ? 'copied' : 'idle';
      if (value !== 'Copied') label.textContent = value;
    };
    let reset: number | undefined;

    button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(button.dataset.copyEmail!);
        setLabel('Copied');
        if (status) status.textContent = 'Email address copied.';
      } catch {
        setLabel('Try again');
        if (status) status.textContent = 'Could not copy the email address.';
      }
      window.clearTimeout(reset);
      reset = window.setTimeout(() => {
        setLabel('Copy email');
        if (status) status.textContent = '';
      }, 2000);
    });
  }

  initCopyEmail();
  document.addEventListener('astro:page-load', initCopyEmail);
</script>
