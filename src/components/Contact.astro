---
import { SITE, contactLinks } from '../site.config';
import Icon from './Icon.astro';
import SectionIndex from './SectionIndex.astro';
// Only channels with an approved value render (see site.config.ts). The big arrow goes to the
// most direct one available: email, then LinkedIn, then GitHub.
const links = contactLinks();
const primary = links[0];
const lead = primary.kind === 'email' ? 'Email is quickest.' : primary.kind === 'linkedin' ? 'LinkedIn is quickest.' : 'GitHub is the best place to reach me and see the code.';
---
<section id="contact" class="contact-section" aria-labelledby="contact-title">
  <div class="shell contact-inner">
    <p class="eyebrow" data-m="slide"><SectionIndex n="04" /> Contact</p>
    <div class="contact-heading">
      <h2 id="contact-title" data-m="mask" data-velocity><span class="line-mask"><span style="--i:0">Hiring for React</span></span><span class="line-mask"><span class="serif" style="--i:1">or frontend?</span></span></h2>
      <a class="contact-arrow" href={primary.href} {...(primary.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})} aria-label={`Contact Giorgi via ${primary.label}`} data-magnetic data-m="scale" style="--delay:300ms"><Icon /></a>
    </div>
    <div class="contact-bottom">
      <span class="contact-rule" data-m="draw" aria-hidden="true"></span>
      <p data-m="clip" style="--delay:200ms">I'd like to hear about the role. {lead}</p>
      <ul class="contact-list" aria-label="Ways to reach Giorgi">
        {links.map(l => (
          <li><a class="contact-link" href={l.href} {...(l.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}><span class="mono">{l.label}</span><span class="contact-value">{l.value}</span><Icon /></a></li>
        ))}
        {SITE.resume && <li><a class="contact-link" href={SITE.resume} target="_blank" rel="noopener"><span class="mono">Résumé</span><span class="contact-value">PDF</span><Icon /></a></li>}
      </ul>
    </div>
  </div>
</section>
