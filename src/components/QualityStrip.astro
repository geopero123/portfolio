---
import spec from '../../tests/homepage.spec.ts?raw';
import { SITE } from '../site.config';
import Icon from './Icon.astro';

const testCount = (spec.match(/^\s*test\(/gm) ?? []).length;
const testSource = `${SITE.siteSource.replace('/tree/', '/blob/')}/tests/homepage.spec.ts`;
---
<aside class="quality-strip shell" aria-label="Portfolio quality checks">
  <div>
    <p><strong>{testCount} browser tests</strong> - 0 accessibility violations (axe, WCAG 2.1 AA) - tested at 6 screen widths</p>
    <a class="text-link" href={testSource} target="_blank" rel="noopener noreferrer">Read the tests <Icon /></a>
  </div>
</aside>

<style>
  .quality-strip > div {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 4px 24px;
    padding-block: 16px;
    border-bottom: 1px solid var(--color-line);
  }
  .quality-strip p { font-size: 12px; }
  .quality-strip strong { color: var(--color-accent); font-weight: 550; }
  .quality-strip a { font-size: 12px; }
</style>
