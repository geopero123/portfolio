<div class="cursor-swarm" data-cursor-swarm transition:persist="cursor-swarm">
  <canvas class="swarm-canvas" data-swarm-canvas aria-hidden="true"></canvas>
  <div class="swarm-controls" data-swarm-controls hidden>
    <button class="swarm-replay" data-swarm-replay type="button" aria-label="Replay page assembly animation">
      <span class="swarm-toggle-dots" aria-hidden="true"><i></i><i></i><i></i></span>
      <span>Replay build</span>
      <svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 5a5.5 5.5 0 1 1-.5 5M3 1v4h4" stroke="currentColor" stroke-width="1.2" /></svg>
    </button>
    <button class="swarm-toggle" data-swarm-toggle type="button" aria-pressed="true" aria-label="Pause cursor swarm and finish building">
      <svg viewBox="0 0 12 12" fill="none" aria-hidden="true"><path class="swarm-pause-icon" d="M4 3v6M8 3v6" stroke="currentColor" stroke-width="1.5" /><path class="swarm-play-icon" d="m4 2 6 4-6 4Z" fill="currentColor" /></svg>
    </button>
  </div>
</div>
