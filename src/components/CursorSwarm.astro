<div class="cursor-swarm" data-cursor-swarm transition:persist="cursor-swarm">
  <canvas class="swarm-canvas" data-swarm-canvas aria-hidden="true" hidden></canvas>
  <div class="swarm-controls" data-swarm-controls hidden>
    <button class="swarm-replay" data-swarm-replay type="button" aria-label="Replay build: watch cursor workers assemble this screen">
      <span class="swarm-toggle-dots" aria-hidden="true"><i></i><i></i><i></i></span>
      <span>Replay build</span>
      <svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 5a5.5 5.5 0 1 1-.5 5M3 1v4h4" stroke="currentColor" stroke-width="1.2" /></svg>
    </button>
    <button class="swarm-toggle" data-swarm-toggle type="button" aria-label="Skip build animation" hidden>
      <svg viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="M3 2v8l5-4Z" fill="currentColor" /><path d="M9.5 2v8" stroke="currentColor" stroke-width="1.4" /></svg>
    </button>
  </div>
</div>
