---
import { projects } from '../data/projects';
import SectionIndex from './SectionIndex.astro';
/**
 * The stack as a map: layers on the left, and a project rail that lights up the
 * technologies each project actually uses. Only verified stacks appear.
 */
const layers = [
  { id: 'ui', name: 'Interface', note: 'Where the experience takes shape.', items: ['React', 'Next.js', 'JavaScript', 'TypeScript'] },
  { id: 'style', name: 'Styling', note: 'Layout, rhythm, the way it feels.', items: ['HTML', 'CSS / SCSS', 'Tailwind CSS', 'MUI'] },
  { id: 'back', name: 'Backend', note: 'The logic that holds it together.', items: ['Laravel', 'PHP', 'MySQL', 'Supabase'] },
  { id: 'ship', name: 'Workflow', note: 'From branch to production.', items: ['Git / GitHub', 'Vite', 'Vercel', 'Cloudflare'] },
];
// Normalise stack labels so "React 19" lights "React", "Motion" is its own thing, etc.
const key = (s: string) => s.toLowerCase().replace(/\s*\d+$/, '').replace(/[^a-z/]/g, '');
const uses = (tech: string) => projects.filter(p => p.stack.some(s => key(s) === key(tech))).map(p => p.slug).join(' ');
---
<section id="stack" class="stack-section shell section-pad" aria-labelledby="stack-title">
  <div class="section-topline"><p class="eyebrow"><SectionIndex n="03" /> The toolkit</p><span class="mono subtle" data-m="slide" data-from="right">Good tools. Better possibilities.</span></div>
  <div class="section-heading">
    <h2 id="stack-title" data-m="mask" data-velocity><span class="line-mask"><span style="--i:0">Built on</span></span><span class="line-mask"><span class="serif" style="--i:1">solid foundations.</span></span></h2>
    <p data-m="clip" style="--delay:200ms">From the first pixel<br />to the last database query.</p>
  </div>

  <div class="stack-map" data-stack>
    <div class="stack-rail" role="group" aria-label="Highlight the stack behind a project">
      <span class="mono stack-rail-label">Show what powers</span>
      <button type="button" class="stack-chip is-active" data-stack-project="" aria-pressed="true">Everything</button>
      {projects.map(p => <button type="button" class="stack-chip" data-stack-project={p.slug} aria-pressed="false">{p.name}</button>)}
    </div>
    <div class="stack-layers">
      {layers.map((layer, i) => (
        <div class="stack-layer" data-m="slide" style={`--delay:${i * 80}ms`}>
          <div class="stack-layer-head"><span class="mono">0{i + 1}</span><div><h3>{layer.name}</h3><p>{layer.note}</p></div></div>
          <span class="stack-line" data-m="draw" style={`--delay:${i * 80 + 200}ms`} aria-hidden="true"></span>
          <ul>{layer.items.map(tech => <li data-for={uses(tech)}>{tech}</li>)}</ul>
        </div>
      ))}
    </div>
    <p class="stack-note mono" data-stack-note aria-live="polite"></p>
  </div>
</section>
<script>
  // Lighting the stack for a project. The map itself is static CSS; only this state changes.
  function init() {
    const map = document.querySelector<HTMLElement>('[data-stack]');
    if (!map || map.dataset.ready) return;
    map.dataset.ready = '1';
    const chips = [...map.querySelectorAll<HTMLButtonElement>('[data-stack-project]')];
    const note = map.querySelector<HTMLElement>('[data-stack-note]');
    const techs = [...map.querySelectorAll<HTMLElement>('li[data-for]')];
    const pick = (chip: HTMLButtonElement) => {
      const slug = chip.dataset.stackProject ?? '';
      map.dataset.project = slug;
      chips.forEach(c => { const on = c === chip; c.classList.toggle('is-active', on); c.setAttribute('aria-pressed', String(on)); });
      techs.forEach(t => t.classList.toggle('is-lit', !slug || (t.dataset.for ?? '').split(' ').includes(slug)));
      if (note) note.textContent = slug ? `${techs.filter(t => t.classList.contains('is-lit')).length} of ${techs.length} - the parts of the stack behind ${chip.textContent}` : '';
    };
    chips.forEach(chip => { chip.addEventListener('click', () => pick(chip)); chip.addEventListener('pointerenter', () => { if (matchMedia('(hover: hover)').matches) pick(chip); }); });
    techs.forEach(t => t.classList.add('is-lit'));
  }
  init();
  document.addEventListener('astro:page-load', init);
</script>
