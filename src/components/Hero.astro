---
import ShapeStudy from './ShapeStudy.astro';
import Icon from './Icon.astro';
---
<section id="home" class="hero shell" aria-labelledby="hero-title" data-hero>
  <div class="hero-layout">
    <div class="hero-copy">
      <p class="hero-intro"><span class="intro-dash"></span><span class="intro-text">Hi, I'm Gio</span> <span class="intro-wave">✳</span></p>
      <h1 id="hero-title">
        <span class="line-mask"><span class="hero-line hero-line-1" data-weight>Serious code.</span></span>
        <span class="line-mask"><span class="hero-line hero-line-2 serif"><span class="word" style="--i:0">Playful</span> <span class="word" style="--i:1">details.</span></span></span>
      </h1>
      <p class="hero-description">A React and full-stack developer with an eye for design.<br />From focused browser tools to a full content platform,<br class="desktop-break" /> I build things that feel as good as they work.</p>
      <div class="hero-actions"><a class="button button-primary" href="#flagship" data-magnetic>Explore my work <Icon class="button-arrow" /></a><a class="text-link" href="/about">About me <Icon /></a></div>
      <p class="hero-role mono">React <span>/</span> Next.js <span>/</span> Full-stack <span>/</span> The little details</p>
    </div>
    <ShapeStudy />
  </div>
  <div class="hero-baseline"><a href="#flagship" class="scroll-link mono"><span class="scroll-icon"><Icon name="down" /></span>Scroll to explore</a><p class="mono">Thoughtfully designed. Personally built.</p><span class="mono hero-year">PORTFOLIO - 2026</span></div>
</section>
