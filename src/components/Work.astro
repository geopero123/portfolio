---
import { Image } from 'astro:assets';
import { projects, getProject, VERIFIED_ON, type Project } from '../data/projects';
import { SITE } from '../site.config';
import spoilerAnime from '../assets/projects/tempest-spoiler-anime.png';
import spoilerModerate from '../assets/projects/tempest-spoiler-moderate.png';
import spoilerFull from '../assets/projects/tempest-spoiler-full.png';
import BrowserFrame from './BrowserFrame.astro';
import Icon from './Icon.astro';
import QuireDemo from './QuireDemo.astro';
import Odometer from './Odometer.astro';
import RebirthClip from './RebirthClip.astro';
import SectionIndex from './SectionIndex.astro';

/**
 * Selected work. Three featured projects, each in the same order a reviewer asks:
 * what does it let people do → my role → one engineering decision → evidence to inspect.
 * The other five projects follow as a compact grid with their real names and domains.
 */
const tempest = getProject('tempest-archive')!;
const quire = getProject('quire')!;
const siteforge = getProject('siteforge')!;
const secondary = ['tempest-rebirth', 'transmute', 'signal', 'folio', 'kilo'].map(slug => getProject(slug)!);
const host = (url: string) => url.replace(/^https?:\/\//, '').replace(/\/$/, '');
const external = (href: string) => /^https?:/.test(href);

// Counted on each live index page at each spoiler level (see VERIFIED_ON). Full matches the sitemap.
const levels = [
  { id: 'anime', label: 'Anime', image: spoilerAnime, counts: [39, 28, 13, 10] },
  { id: 'moderate', label: 'Moderate', image: spoilerModerate, counts: [53, 45, 21, 16] },
  { id: 'full', label: 'Full', image: spoilerFull, counts: [84, 85, 36, 26], extra: ' Late entries such as Apito are tagged FULL.' },
];
const kinds = ['Characters', 'Skills', 'Locations', 'Factions'];
const total = (counts: number[]) => counts.reduce((a, b) => a + b, 0);
const noteFor = (l: (typeof levels)[number]) => `${l.label}: ${total(l.counts)} entries across the four indexes, ${l.counts[0]} of them characters.${l.extra ?? ''}`;

const features: { p: Project; n: string; kind: string }[] = [
  { p: tempest, n: '01', kind: 'React app · content platform' },
  { p: quire, n: '02', kind: 'React app · browser tool' },
  { p: siteforge, n: '03', kind: 'Next.js app · website and code QA' },
];
---
<section id="projects" class="work-section section-pad" aria-labelledby="work-title">
  <div class="shell">
    <div class="section-topline"><p class="eyebrow"><SectionIndex n="01" /> Selected work</p><span class="mono subtle" data-m="slide" data-from="right">{projects.length} live projects</span></div>
    <div class="section-heading">
      <h2 id="work-title" data-m="mask"><span class="line-mask"><span style="--i:0">Three projects,</span></span> <span class="line-mask"><span class="serif" style="--i:1">in depth.</span></span></h2>
      <p data-m="clip" style="--delay:200ms">What each one lets people do, what I did, one decision behind it, and evidence you can check yourself.</p>
    </div>
  </div>

  {features.map(({ p, n, kind }) => (
    <article id={p.flagship ? 'tempest' : p.slug} class:list={['feature', `feature-${p.slug}`]} aria-labelledby={`feature-${p.slug}-title`} style={`--feature-accent:${p.accent}`}>
      <div class="shell">
        <div class="feature-grid">
          <header class="feature-head">
            <p class="mono feature-kicker"><span>{n}</span> {kind}</p>
            <h3 id={`feature-${p.slug}-title`} class="feature-title" data-m="mask"><span class="line-mask"><span transition:name={`project-title-${p.slug}`}>{p.name}</span></span></h3>
            <p class="feature-does" data-m="clip" style="--delay:120ms">{p.feature!.does}</p>
            <dl class="feature-meta">
              <div><dt class="mono">My role</dt><dd>{p.role}</dd></div>
              <div><dt class="mono">Stack</dt><dd>{p.stack.join(', ')}</dd></div>
              <div><dt class="mono">Live at</dt><dd><a href={p.live} target="_blank" rel="noopener noreferrer">{host(p.live)}</a></dd></div>
            </dl>
            <div class="feature-actions">
              <a class="button button-primary" href={p.live} target="_blank" rel="noopener noreferrer" data-magnetic>{p.flagship ? 'Visit Tempest Archive' : `Open ${p.name}`} <Icon class="button-arrow" /></a>
              <a class="text-link" href={`/projects/${p.slug}`}>Read the case study <Icon /></a>
            </div>
          </header>

          {p.flagship ? (
            <figure class="spoiler-demo" data-spoiler-demo aria-labelledby="spoiler-caption">
              <figcaption id="spoiler-caption" class="spoiler-caption"><span class="mono">Try it</span> Same page, three reader settings. Pick a spoiler level to see the live Characters index at that level.</figcaption>
              <div class="spoiler-switch" role="group" aria-label="Spoiler level" data-enhancement hidden>
                {levels.map((l, i) => <button type="button" data-spoiler-level={l.id} data-note={noteFor(l)} aria-pressed={i === 0 ? 'true' : 'false'}><span aria-hidden="true">◆</span> {l.label}</button>)}
              </div>
              <div class="spoiler-frame" transition:name={`project-image-${p.slug}`}>
                {levels.map((l, i) => (
                  <div class:list={['spoiler-shot', { 'is-active': i === 0 }]} data-spoiler-shot={l.id} aria-hidden={i !== 0 ? 'true' : undefined}>
                    <BrowserFrame image={l.image} alt={`Tempest Archive Characters index at the ${l.label} spoiler level, reading "${l.counts[0]} of ${l.counts[0]} shown"${l.id === 'full' ? ', with late characters such as Apito and Adalmann tagged FULL' : ''}`} url="https://tempestarchive.com/characters/" tone="dark" sizes="(max-width: 760px) 92vw, 52vw" loading={i === 0 ? 'eager' : 'lazy'} />
                  </div>
                ))}
              </div>
              <div class="spoiler-table-wrap">
                <table class="spoiler-table">
                  <caption class="sr-only">Entries shown on each live index page, by spoiler level</caption>
                  <thead><tr><th scope="col">Level</th>{kinds.map(k => <th scope="col">{k}</th>)}<th scope="col">Total</th></tr></thead>
                  <tbody>
                    {levels.map((l, i) => (
                      <tr data-spoiler-row={l.id} class:list={{ 'is-active': i === 0 }}>
                        <th scope="row">{l.label}</th>
                        {l.counts.map(c => <td><Odometer text={String(c)} entrance={false} /></td>)}
                        <td><Odometer text={String(total(l.counts))} entrance={false} /></td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
              <p class="spoiler-note mono" aria-live="polite" data-spoiler-note>{noteFor(levels[0])}</p>
              <p class="spoiler-source mono">Counted on the live index pages, {VERIFIED_ON}.</p>
            </figure>
          ) : p.slug === 'quire' ? (
            <div class="pdf-demo">
              <QuireDemo />
              <a class="pdf-paper" href={p.sample!.href} target="_blank" rel="noopener">
                <Image src={p.sample!.image} alt={p.sample!.alt} widths={[360, 560, 800]} sizes="(max-width: 760px) 70vw, 24vw" format="webp" quality={85} loading="lazy" decoding="async" />
                <span class="pdf-badge mono">Open sample PDF · {p.sample!.summary} <Icon /></span>
              </a>
              <div class="pdf-app">
                <BrowserFrame image={p.image} alt={p.alt} url={p.live} sizes="(max-width: 760px) 92vw, 36vw" transitionName={`project-image-${p.slug}`} />
              </div>
              <p class="pdf-caption mono">The paper is page 1 of the sample, exported from {host(p.live)}. Open it and select the text, or click the link under “Further reading”.</p>
            </div>
          ) : (
            <div class="siteforge-preview">
              <BrowserFrame image={p.image} alt={p.alt} url={p.live} tone={p.tone} sizes="(max-width: 1100px) 90vw, 52vw" transitionName={`project-image-${p.slug}`} />
              <figure class="siteforge-flow">
                <figcaption class="eyebrow">From request to report</figcaption>
                <svg viewBox="0 0 420 176" role="img" aria-labelledby="siteforge-flow-title siteforge-flow-desc">
                  <title id="siteforge-flow-title">SiteForge audit pipeline</title>
                  <desc id="siteforge-flow-desc">The Next.js app queues the audit. A worker runs Chromium and scans the repository, then returns the report.</desc>
                  <defs>
                    <marker id="audit-arrow" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
                      <path d="M1 1L7 4L1 7" fill="none" stroke="currentColor" stroke-width="1.2" />
                    </marker>
                  </defs>
                  <g class="flow-edges" marker-end="url(#audit-arrow)">
                    <path d="M128 22H146" /><path d="M271 22H289" />
                    <path d="M353 41V61H210V76" /><path d="M210 115V136" />
                  </g>
                  <g class="flow-nodes">
                    <rect x="4" y="4" width="124" height="37" rx="5" /><text x="66" y="22">Next.js app</text>
                    <rect x="147" y="4" width="124" height="37" rx="5" /><text x="209" y="22">Queue</text>
                    <rect x="290" y="4" width="124" height="37" rx="5" /><text x="352" y="22">Worker</text>
                    <rect x="65" y="77" width="290" height="38" rx="5" /><text x="210" y="96">Chromium + repository scan</text>
                    <rect x="143" y="137" width="134" height="37" rx="5" /><text x="210" y="155">Report</text>
                  </g>
                </svg>
              </figure>
            </div>
          )}
        </div>

        <div class="feature-proof">
          <div class="decision">
            <p class="eyebrow">Engineering decision</p>
            <h4>{p.feature!.decision.title}</h4>
            <p>{p.feature!.decision.body}</p>
          </div>
          <div class="evidence">
            <p class="eyebrow">Evidence to inspect</p>
            <ul>
              {p.feature!.evidence.map(e => (
                <li>
                  {e.href
                    ? <a href={e.href} {...(external(e.href) || e.download ? { target: '_blank', rel: 'noopener noreferrer' } : {})}><span class="evidence-label">{e.label}</span><span class="evidence-text">{e.text}</span><Icon class="evidence-arrow" name={external(e.href) && e.href.includes('github.com') ? 'code' : 'arrow'} /></a>
                    : <div><span class="evidence-label">{e.label}</span><span class="evidence-text">{e.text}</span></div>}
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </article>
  ))}

  <div class="shell more-work" aria-labelledby="more-title">
    <div class="more-head">
      <h3 id="more-title">More projects</h3>
      <p>A 3D browser game and four tools that work on your device. All five are live.</p>
    </div>
    <ul class="tool-grid">
      {secondary.map(p => (
        <li class="tool-card" data-depth style={`--tool-accent:${p.accent}`}>
          <a class="tool-shot" href={p.live} target="_blank" rel="noopener noreferrer" tabindex="-1" aria-hidden="true">
            <span class="tool-preview" transition:name={`project-image-${p.slug}`}>
              <Image src={p.image} alt="" widths={[400, 640, 900]} sizes="(max-width: 760px) 92vw, (max-width: 1100px) 46vw, (max-width: 1600px) 30vw, 480px" format="webp" quality={80} loading="lazy" decoding="async" />
              {p.slug === 'tempest-rebirth' && <RebirthClip image={p.image} />}
            </span>
          </a>
          <div class="tool-body">
            <h4><a href={`/projects/${p.slug}`} transition:name={`project-title-${p.slug}`}>{p.name}</a></h4>
            <p class="tool-tagline">{p.tagline}</p>
            <p class="tool-desc">{p.description}</p>
            <p class="tool-stack mono">{p.stack.join(' · ')}</p>
            <div class="tool-links">
              <a href={p.live} target="_blank" rel="noopener noreferrer" aria-label={`${p.name} live at ${host(p.live)}`}>{host(p.live)} <Icon /></a>
              <a href={`/projects/${p.slug}`} aria-label={`${p.name} details`}>Details</a>
              {p.source && <a href={p.source} target="_blank" rel="noopener noreferrer" aria-label={`${p.name} source code`}><Icon name="github" /> Source</a>}
            </div>
          </div>
        </li>
      ))}
    </ul>
    <div class="work-bottom">
      <p>The five browser tools live in one repository and deploy separately to their own subdomains. Tempest Archive's repository is private.</p>
      <div class="work-sources">
        <a class="text-link" href={SITE.projectsRepository} target="_blank" rel="noopener noreferrer"><Icon name="github" /> Tools source</a>
        <a class="text-link" href={SITE.siteSource} target="_blank" rel="noopener noreferrer"><Icon name="github" /> This site's source</a>
      </div>
    </div>
  </div>
</section>
<script>
  import { rollDigits } from '../scripts/odometer';

  // Spoiler demo: swap the real screenshot and highlight the matching row. Without JS the
  // first screen and the full table stay visible, which already tells the story.
  function init() {
    const demo = document.querySelector<HTMLElement>('[data-spoiler-demo]');
    if (!demo || demo.dataset.ready) return;
    demo.dataset.ready = '1';
    const buttons = [...demo.querySelectorAll<HTMLButtonElement>('[data-spoiler-level]')];
    const shots = [...demo.querySelectorAll<HTMLElement>('[data-spoiler-shot]')];
    const rows = [...demo.querySelectorAll<HTMLElement>('[data-spoiler-row]')];
    const note = demo.querySelector<HTMLElement>('[data-spoiler-note]');
    let active = rows[0];
    buttons.forEach(button => button.addEventListener('click', () => {
      const level = button.dataset.spoilerLevel!;
      buttons.forEach(b => b.setAttribute('aria-pressed', String(b === button)));
      shots.forEach(s => { const on = s.dataset.spoilerShot === level; s.classList.toggle('is-active', on); if (on) s.removeAttribute('aria-hidden'); else s.setAttribute('aria-hidden', 'true'); });
      const next = rows.find(row => row.dataset.spoilerRow === level);
      if (next && next !== active) {
        const previous = [...active.querySelectorAll('[data-odometer] .sr-only')];
        active.classList.remove('is-active');
        next.classList.add('is-active');
        next.querySelectorAll('[data-odometer]').forEach((cell, i) => rollDigits(cell, previous[i]?.textContent ?? '0'));
        active = next;
      }
      if (note) note.textContent = button.dataset.note ?? '';
    }));
    demo.querySelector<HTMLElement>('.spoiler-switch')?.removeAttribute('hidden');
  }
  init();
  document.addEventListener('astro:page-load', init);
</script>
