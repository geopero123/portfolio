---
import { Image } from 'astro:assets';
import { flagship as p } from '../data/projects';
import BrowserFrame from './BrowserFrame.astro';
import TechStrip from './TechStrip.astro';
import Icon from './Icon.astro';
import SectionIndex from './SectionIndex.astro';
const detail = `/projects/${p.slug}`;
// Pinned story: each chapter pairs a verified fact with the real screen that shows it.
const [dossier, timeline, characters] = p.screens!;
const chapters = [
  { fact: p.facts![0], screen: { image: p.image, alt: p.alt }, caption: 'Home · spoiler level', tags: ['Anime', 'Moderate', 'Full'] },
  { fact: p.facts![1], screen: timeline, caption: 'Timeline', tags: ['Light novel', 'Web novel', 'Never merged'] },
  { fact: p.facts![2], screen: dossier, caption: 'Character dossier', tags: ['Written from scratch', 'No reproduced prose'] },
  { fact: p.facts![3], screen: characters, caption: 'Characters index', tags: ['Characters', 'Skills', 'Places', 'Events'] },
];
---
<section id="flagship" class="flagship" aria-labelledby="flagship-title" style={`--flag-accent:${p.accent}`}>
  <div class="shell">
    <div class="section-topline">
      <p class="eyebrow"><SectionIndex n="01" /> Flagship project</p>
      <a class="mono subtle flagship-domain" href={p.live} target="_blank" rel="noopener noreferrer" data-m="slide" data-from="right">tempestarchive.com <Icon /></a>
    </div>

    <div class="flagship-grid" data-depth>
      <div class="flagship-copy">
        <h2 id="flagship-title" class="flagship-title" data-m="mask" data-velocity>
          <span class="line-mask"><span style="--i:0">Tempest</span></span>
          <span class="line-mask"><span class="serif" style="--i:1">Archive.</span></span>
        </h2>
        <p class="flagship-tagline mono" data-m="slide" style="--delay:250ms">{p.tagline}</p>
        <p class="flagship-lead" data-m="clip" style="--delay:320ms">{p.description}</p>
        <dl class="flagship-meta" data-m="stagger" style="--delay:420ms">
          <div><dt class="mono">Type</dt><dd>{p.type}</dd></div>
          <div><dt class="mono">Role</dt><dd>{p.role}</dd></div>
          <div><dt class="mono">Status</dt><dd>{p.year}</dd></div>
        </dl>
        <TechStrip items={p.stack} delay={520} />
        <div class="flagship-actions" data-m="stagger" style="--delay:600ms">
          <a class="button button-primary" href={p.live} target="_blank" rel="noopener noreferrer" data-magnetic>Visit Tempest Archive <Icon class="button-arrow" /></a>
          <a class="text-link" href={detail}>Read the case study <Icon /></a>
        </div>
      </div>

      <div class="flagship-visual">
        <svg class="flagship-seal depth-layer" style="--dz:.4" viewBox="0 0 24 24" aria-hidden="true" data-m="draw"><path d="M12 2.5 21.5 12 12 21.5 2.5 12z" pathLength="1" style="--i:0"/><path d="M12 7.5 16.5 12 12 16.5 7.5 12z" pathLength="1" style="--i:1"/></svg>
        <div class="flagship-desktop depth-layer" style="--dz:.5" data-m="scale">
          <BrowserFrame image={p.image} alt={p.alt} url={p.live} tone="dark" sizes="(max-width: 760px) 92vw, 56vw" transitionName={`project-image-${p.slug}`} />
        </div>
        {p.mobile && <div class="flagship-phone depth-layer" style="--dz:1.5" data-m="scale" data-from="right">
          <div class="phone"><div class="phone-screen"><Image src={p.mobile.image} alt={p.mobile.alt} widths={[240, 390, 640]} sizes="(max-width: 760px) 34vw, 14vw" format="webp" quality={80} loading="lazy" decoding="async" /></div></div>
        </div>}
        <div class="flagship-crop depth-layer" style="--dz:1.1" data-m="clip" data-from="left">
          <span class="mono crop-label">Spoiler level</span>
          <div class="crop-window"><Image src={p.image} alt="" widths={[1200]} sizes="1200px" format="webp" quality={80} loading="lazy" decoding="async" aria-hidden="true" /></div>
        </div>
        <span class="flagship-hairline" data-m="draw" data-from="right" aria-hidden="true"></span>
      </div>
    </div>

    <!-- Pinned story: the frame stays put while the chapters scroll and swap the screen. -->
    <div class="story" data-story aria-label="What makes Tempest Archive different">
      <div class="story-visual">
        <span class="story-progress" aria-hidden="true"><i></i></span>
        <div class="story-frame" data-depth>
          {chapters.map((c, i) => (
            <div class:list={['story-screen', 'depth-layer', {'is-active': i === 0}]} style="--dz:.5" data-screen={i} aria-hidden={i !== 0}>
              <BrowserFrame image={c.screen.image} alt={c.screen.alt} url={p.live} tone="dark" sizes="(max-width: 760px) 92vw, 52vw" loading={i === 0 ? 'eager' : 'lazy'} />
            </div>
          ))}
        </div>
        <p class="story-meta mono" aria-live="polite"><span class="story-n" data-story-n>01</span><span class="subtle"> / 0{chapters.length} · </span><span data-story-label>{chapters[0].caption}</span></p>
      </div>
      <ol class="story-chapters">
        {chapters.map((c, i) => (
          <li class:list={['story-chapter', {'is-active': i === 0}]} data-chapter={i} data-caption={c.caption}>
            <span class="mono story-chapter-n">{String(i + 1).padStart(2, '0')}</span>
            <h3>{c.fact.label}</h3>
            <p>{c.fact.text}</p>
            <ul class="story-tags mono" aria-label="Details">{c.tags.map((t, k) => <li style={`--i:${k}`}>{t}</li>)}</ul>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>
