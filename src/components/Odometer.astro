---
/**
 * Digits rendered as an odometer. Rendered at build time so nothing is rewritten in the
 * browser (no layout shift); the roll itself is CSS on `.in`.
 */
interface Props { text: string; class?: string; entrance?: boolean }
const { text, class: className, entrance = true } = Astro.props;
---
<span class={className} data-odometer data-m={entrance ? "count" : undefined}>
  <span class="sr-only">{text}</span>
  {[...text].map(ch => /\d/.test(ch)
    ? <span class="digit" aria-hidden="true"><span class="digit-roll" style={`--d:${ch}`}>{Array.from({length: 10}, (_, i) => <span>{i}</span>)}</span></span>
    : <span aria-hidden="true">{ch}</span>)}
</span>
