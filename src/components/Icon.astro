---
interface Props { name?: "arrow" | "down" | "github" | "plus" | "code"; class?: string }
const { name = "arrow", class: className } = Astro.props;
---
<svg class={className} width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {name === "arrow" && <path d="M5 19 19 5M5 5h14v14" />}
  {name === "down" && <path d="M12 4v16m-6-6 6 6 6-6" />}
  {name === "plus" && <path d="M12 5v14M5 12h14" />}
  {name === "code" && <path d="m8 6-6 6 6 6m8-12 6 6-6 6M14 3l-4 18" />}
  {name === "github" && <path d="M9 19c-4.3 1.3-4.3-2.2-6-2.7M15 22v-3.9a3.4 3.4 0 0 0-1-2.6c3.3-.4 6.8-1.6 6.8-7.3a5.7 5.7 0 0 0-1.5-4 5.4 5.4 0 0 0-.1-4S18 0 15 1.5a13.4 13.4 0 0 0-6 0C6 0 4.8.3 4.8.3a5.4 5.4 0 0 0-.1 4 5.7 5.7 0 0 0-1.5 4c0 5.7 3.5 6.9 6.8 7.3a3.4 3.4 0 0 0-1 2.5V22" transform="translate(1 1) scale(.92)" />}
</svg>
