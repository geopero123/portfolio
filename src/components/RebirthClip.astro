---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props { image: ImageMetadata }
const { image } = Astro.props;
const poster = await getImage({src: image, width: 800, format: 'webp', quality: 82});
---
<video class="rebirth-clip" data-rebirth-clip muted loop playsinline preload="none" poster={poster.src} aria-hidden="true">
  <source data-src="/media/rebirth.webm" type="video/webm" />
  <source data-src="/media/rebirth.mp4" type="video/mp4" />
</video>

<style>
  .rebirth-clip {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    opacity: 0;
    pointer-events: none;
  }
  .rebirth-clip[data-playing="true"] { opacity: 1; }
  @media (prefers-reduced-motion: reduce) {
    .rebirth-clip { display: none; }
  }
</style>

<script>
  const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
  let cleanup: (() => void) | undefined;

  function initClips() {
    cleanup?.();
    const clips = [...document.querySelectorAll<HTMLVideoElement>('[data-rebirth-clip]')];
    if (!clips.length || !('IntersectionObserver' in window)) return;
    const lifetime = new AbortController();
    const { signal } = lifetime;
    const visible = new Set<HTMLVideoElement>();

    function sync(video: HTMLVideoElement) {
      if (reducedMotion.matches || document.hidden || !visible.has(video)) {
        video.pause();
        return;
      }
      if (!video.querySelector('source[src]')) {
        for (const source of video.querySelectorAll<HTMLSourceElement>('source[data-src]')) source.src = source.dataset.src!;
        video.load();
      }
      void video.play().catch(() => { delete video.dataset.playing; });
    }

    const observer = new IntersectionObserver(entries => {
      for (const entry of entries) {
        const video = entry.target as HTMLVideoElement;
        if (entry.isIntersecting && entry.intersectionRatio >= .18) visible.add(video);
        else visible.delete(video);
        sync(video);
      }
    }, { threshold: .18 });

    for (const video of clips) {
      observer.observe(video);
      video.addEventListener('playing', () => { video.dataset.playing = 'true'; }, { signal });
      video.addEventListener('error', () => { delete video.dataset.playing; }, { signal });
    }
    const refresh = () => clips.forEach(sync);
    reducedMotion.addEventListener('change', refresh, { signal });
    document.addEventListener('visibilitychange', refresh, { signal });
    cleanup = () => {
      lifetime.abort();
      observer.disconnect();
      clips.forEach(video => video.pause());
      cleanup = undefined;
    };
  }

  initClips();
  document.addEventListener('astro:page-load', initClips);
  document.addEventListener('astro:before-swap', () => cleanup?.());
</script>
