---
import { sculptureShapes, wireArtwork } from '../lib/sculpture';
import Icon from './Icon.astro';
import { SITE } from '../site.config';
const source = (path: string) => `${SITE.siteSource.replace('/tree/', '/blob/')}/${path}`;
---
<div class="shape-study" data-shape-study>
  <div class="study-heading"><span class="eyebrow"><span class="status-dot"></span> Form & interaction</span><span class="mono study-edition">Study 001</span></div>
  <div class="shape-stage" data-shape-stage>
    <div class="stage-grid" aria-hidden="true"></div><div class="stage-light" aria-hidden="true"></div>
    <span class="crosshair crosshair-tl" aria-hidden="true">+</span><span class="crosshair crosshair-br" aria-hidden="true">+</span>
    <div class="sculpture" data-sculpture data-active-shape="ribbon" role="img" aria-label="Orange wire sculpture: Ribbon">
      <svg class="sculpture-layer" data-shape-layer="ribbon" viewBox="0 0 520 520" aria-hidden="true">
        <Fragment set:html={wireArtwork('ribbon')} />
      </svg>
      {sculptureShapes.slice(1).map(({id}) => (
        <img class="sculpture-layer" data-shape-layer={id} src={`/sculpture/${id}.svg`} width="520" height="520" alt="" decoding="async" loading="lazy" />
      ))}
      <svg class="construction-lines" viewBox="0 0 520 520" fill="none" stroke="#a49a8a" stroke-width=".6" stroke-dasharray="3 6" aria-hidden="true">
        <circle cx="260" cy="260" r="208" /><path d="M20 260h480M260 20v480M100 100l320 320M420 100 100 420" />
      </svg>
    </div>
    <span class="stage-axis mono" aria-hidden="true">X / Y / Z</span>
    <span class="stage-caption mono"><span class="pointer-instruction">Move your cursor to explore</span><span class="touch-instruction">A small study in interaction</span></span>
  </div>
  <div class="study-controls" data-enhancement hidden>
    <div class="shape-options" role="group" aria-label="Sculpture shape">
      {sculptureShapes.map(({ id, name }, index) => <button type="button" data-shape={id} aria-pressed={index === 0 ? 'true' : 'false'}>0{index + 1} <span>{name}</span></button>)}
    </div>
    <button class="inspect-toggle" type="button" data-inspect aria-pressed="false" aria-label="Show construction guides"><Icon name="plus" /><span>Inspect</span></button>
  </div>
  <!-- The creative pieces are work samples too: say what they are and where the code lives. -->
  <p class="study-note">
    <span>Built for this site: a 48-ring SVG sculpture (<a href={source('src/lib/sculpture.ts')} target="_blank" rel="noopener noreferrer">sculpture.ts</a>) and a canvas of cursor workers that assemble the page (<a href={source('src/scripts/swarm.ts')} target="_blank" rel="noopener noreferrer">swarm.ts</a>).</span>
    <button type="button" class="study-replay" data-swarm-replay data-enhancement hidden><span class="swarm-toggle-dots" aria-hidden="true"><i></i><i></i><i></i></span>Replay build</button>
  </p>
</div>
