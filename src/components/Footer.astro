---
import { SITE } from '../site.config';
import Icon from './Icon.astro';
---
<footer class="site-footer shell">
  <a href="/" class="wordmark" aria-label="Made by Gio, back to top">madeby<span>gio</span><span class="brand-dot">.</span></a>
  <p><span class="footer-arrived">You made it to the end. </span>© {new Date().getFullYear()} Giorgi. Built with Astro.</p>
  <div>
    <a href="/#projects">Work</a>
    <a href="/about">About</a>
    <a href={SITE.socials.github} target="_blank" rel="noopener noreferrer">GitHub <Icon /></a>
    {SITE.socials.linkedin && <a href={SITE.socials.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn <Icon /></a>}
    <a href={SITE.siteSource} target="_blank" rel="noopener noreferrer">Site source <Icon /></a>
    <button type="button" class="footer-replay" data-swarm-replay data-enhancement hidden><span class="swarm-toggle-dots" aria-hidden="true"><i></i><i></i><i></i></span>Replay build</button>
    <a href="#main" aria-label="Back to top">Top <Icon name="down" class="back-arrow" /></a>
  </div>
</footer>
