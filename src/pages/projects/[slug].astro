---
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import BrowserFrame from '../../components/BrowserFrame.astro';
import TechStrip from '../../components/TechStrip.astro';
import Icon from '../../components/Icon.astro';
import { projects, type Project } from '../../data/projects';
import { SITE } from '../../site.config';

export function getStaticPaths() {
  return projects.map((p, i) => ({ params: { slug: p.slug }, props: { project: p, index: i, next: projects[(i + 1) % projects.length] } }));
}
interface Props { project: Project; index: number; next: Project }
const { project: p, index, next } = Astro.props;
const number = String(index + 1).padStart(2, '0');
const [first, ...rest] = p.name.split(' ');
const title = p.flagship ? `Tempest Archive - a spoiler-aware Tensura companion` : `${p.name} - ${p.tagline}`;
const description = p.flagship
  ? 'Tempest Archive is a React web app and content archive for That Time I Got Reincarnated as a Slime, built by Gio: original story summaries, character dossiers, skills, locations, factions and a linked timeline, filtered by spoiler level.'
  : `${p.description} Built by Gio with ${p.stack.slice(0, 3).join(', ')}.`;
const schema = [
  p.flagship
    ? { "@type": "CreativeWork", "@id": `${SITE.url}/projects/${p.slug}#work`, name: p.name, url: p.live, description, author: { "@type": "Person", name: SITE.fullName, url: SITE.url }, genre: "Fan companion / reference web application", keywords: p.stack.join(', ') }
    : { "@type": "SoftwareApplication", "@id": `${SITE.url}/projects/${p.slug}#app`, name: p.name, url: p.live, description: p.description, applicationCategory: p.schemaCategory ?? "UtilitiesApplication", operatingSystem: "Web browser", author: { "@type": "Person", name: SITE.fullName, url: SITE.url }, ...(p.source ? { codeRepository: p.source } : {}) },
];
let section = 0;
const n = () => String(++section).padStart(2, '0');
// Pinned story: the frame stays while The idea / The challenge / The build scroll past.
// Tempest swaps between its real reference screens; tools hold their single screenshot.
const tone = p.tone ?? (p.flagship ? 'dark' : 'light');
const stackNote = p.stackNote ?? (p.stack.includes('React 19')
  ? 'A React 19 application built with Vite and Tailwind CSS. Everything runs in the browser; the build is a static folder deployed to Vercel on its own subdomain.'
  : 'A single HTML page with inline CSS and plain JavaScript, no framework. Everything runs in the browser and it deploys as a static page on its own subdomain.');
const storyScreens = p.screens?.length ? [p.screens[2], p.screens[1], p.screens[0]] : [{ image: p.image, alt: p.alt, label: p.name }];
const storyChapters = (p.story ?? []).map((s, i) => ({ ...s, screen: storyScreens[i % storyScreens.length], index: n() }));
---
<Layout title={title} description={description} page="project" article schema={schema} image={`/og-${p.slug}.png`}>
  <article class="project-page" style={`--accent-project:${p.accent}`}>
    <header class="page-hero shell">
      <p class="eyebrow crumbs" data-m="slide"><a href="/#projects"><Icon /> Work</a><span aria-hidden="true">/</span><span class="section-index">{number}</span><span>{p.type}</span></p>
      <h1 data-m="mask">
        <span class="line-mask"><span style="--i:0" transition:name={`project-title-${p.slug}`}>{first}</span></span>{rest.length > 0 && ' '}
        {rest.length > 0 && <span class="line-mask"><span class="serif" style="--i:1">{rest.join(' ')}</span></span>}
      </h1>
      <p class="page-lead" data-m="clip" style="--delay:260ms">{p.flagship ? p.description : `${p.tagline} ${p.description}`}</p>
      <dl class="project-meta" data-m="stagger" style="--delay:340ms">
        <div><dt class="mono">Type</dt><dd>{p.type}</dd></div>
        <div><dt class="mono">Role</dt><dd>{p.role}</dd></div>
        <div><dt class="mono">{p.flagship ? 'Status' : 'Year'}</dt><dd>{p.year}</dd></div>
        <div><dt class="mono">Live at</dt><dd><a href={p.live} target="_blank" rel="noopener noreferrer">{p.live.replace(/^https?:\/\//, '').replace(/\/$/, '')}</a></dd></div>
      </dl>
      <div class="project-actions" data-m="stagger" style="--delay:420ms">
        <a class="button button-primary" href={p.live} target="_blank" rel="noopener noreferrer" data-magnetic>Visit the live site <Icon class="button-arrow" /></a>
        {p.source && <a class="text-link" href={p.source} target="_blank" rel="noopener noreferrer"><Icon name="github" /> View source</a>}
        {p.slug === 'quire' && <a class="text-link" href="/samples/quire-field-notes.pdf" target="_blank" rel="noopener">Sample PDF (13.4 KB) <Icon /></a>}
      </div>
    </header>

    <div class="project-visual shell" data-depth>
      <div class="depth-layer" style="--dz:.35" data-m="scale">
        <BrowserFrame image={p.image} alt={p.alt} url={p.live} tone={tone} sizes="(max-width: 760px) 92vw, 82vw" loading="eager" rebirthClip={p.slug === 'tempest-rebirth'} transitionName={`project-image-${p.slug}`} />
      </div>
    </div>

    <div class="shell">
      {storyChapters.length > 0 && (
        <div class:list={['story', 'story-project', {'story-single': storyScreens.length === 1}]} data-story aria-label="About this project">
          <div class="story-visual">
            <span class="story-progress" aria-hidden="true"><i></i></span>
            <div class="story-frame" data-depth>
              {storyScreens.slice(0, storyChapters.length).map((s, i) => (
                <div class:list={['story-screen', 'depth-layer', {'is-active': i === 0}]} style="--dz:.5" data-screen={i} aria-hidden={i !== 0}>
                  <BrowserFrame image={s.image} alt={s.alt} url={p.live} tone={tone} sizes="(max-width: 760px) 92vw, 46vw" />
                </div>
              ))}
            </div>
            {storyScreens.length > 1 && <p class="story-meta mono" aria-live="polite"><span class="story-n" data-story-n>01</span><span class="subtle"> / 0{storyChapters.length} · </span><span data-story-label>{storyScreens[0].label}</span></p>}
          </div>
          <ol class="story-chapters">
            {storyChapters.map((s, i) => (
              <li class:list={['story-chapter', {'is-active': i === 0}]} data-chapter={i} data-caption={s.screen.label}>
                <p class="eyebrow"><span class="section-index">{s.index} /</span></p>
                <h2 id={`s-${s.heading.replace(/\W+/g, '-').toLowerCase()}`}>{s.heading}</h2>
                {s.body.map(para => <p>{para}</p>)}
              </li>
            ))}
          </ol>
        </div>
      )}

      {p.screens && p.screens.length > 0 && (
        <section class="project-body" aria-labelledby="s-experience">
          <p class="eyebrow" data-m="slide"><span class="section-index">{n()} /</span> Experience</p>
          <div>
            <h2 id="s-experience" data-m="mask"><span class="line-mask"><span>Real screens.</span></span></h2>
            <div class="screens">
              {p.screens.map((s, i) => (
                <figure class:list={{ 'span-2': i === 0 }} data-m="scale" style={`--delay:${i * 100}ms`}>
                  <BrowserFrame image={s.image} alt={s.alt} url={p.live} tone="dark" sizes={i === 0 ? '(max-width: 760px) 92vw, 70vw' : '(max-width: 760px) 92vw, 40vw'} aspect={i === 0 ? '16 / 9' : '16 / 10'} />
                  <figcaption>{s.label}</figcaption>
                </figure>
              ))}
            </div>
          </div>
        </section>
      )}

      {p.flagship && (
        <section class="project-body" aria-labelledby="s-structure">
          <p class="eyebrow" data-m="slide"><span class="section-index">{n()} /</span> Structure</p>
          <div>
            <h2 id="s-structure" data-m="mask"><span class="line-mask"><span>How the archive is organised.</span></span></h2>
            <p data-m="clip" style="--delay:120ms">Six reference sections, all cross-linked, all filtered by the reader's spoiler level. Story records are the spine; everything else hangs off them.</p>
            <TechStrip items={['Story records', 'Timeline', 'Characters', 'Skills & abilities', 'World & locations', 'Factions', 'Search', 'Spoiler level: Anime · Moderate · Full', 'Light-novel / web-novel continuity']} label="Archive sections" delay={200} />
          </div>
        </section>
      )}

      {p.facts && (
        <section class="project-body" aria-labelledby="s-details">
          <p class="eyebrow" data-m="slide"><span class="section-index">{n()} /</span> Details</p>
          <div>
            <h2 id="s-details" data-m="mask"><span class="line-mask"><span>What it actually does.</span></span></h2>
            <ul class="fact-grid">
              {p.facts.map((f, i) => <li data-m="slide" style={`--delay:${i * 70}ms`}><span class="mono">{String(i + 1).padStart(2, '0')}</span><h3>{f.label}</h3><p>{f.text}</p></li>)}
            </ul>
          </div>
        </section>
      )}

      <section class="project-body" aria-labelledby="s-stack">
        <p class="eyebrow" data-m="slide"><span class="section-index">{n()} /</span> Stack</p>
        <div>
          <h2 id="s-stack" data-m="mask"><span class="line-mask"><span>Built with.</span></span></h2>
          <p data-m="clip" style="--delay:120ms">{stackNote}</p>
          <TechStrip items={p.stack} delay={200} />
        </div>
      </section>

      {p.mobile && (
        <section class="project-body" aria-labelledby="s-responsive">
          <p class="eyebrow" data-m="slide"><span class="section-index">{n()} /</span> Responsive</p>
          <div>
            <h2 id="s-responsive" data-m="mask"><span class="line-mask"><span>Desktop and phone.</span></span></h2>
            <p data-m="clip" style="--delay:120ms">The phone layout is its own design, with a bottom tab bar for the sections readers reach for most, rather than the desktop navigation squeezed down.</p>
            <div class="responsive-pair" data-depth>
              <div class="depth-layer" style="--dz:.4" data-m="scale"><BrowserFrame image={p.screens?.[1]?.image ?? p.image} alt={p.screens?.[1]?.alt ?? p.alt} url={p.live} tone="dark" sizes="(max-width: 760px) 60vw, 56vw" /></div>
              <div class="depth-layer" style="--dz:1.3;--delay:150ms" data-m="scale" data-from="right"><div class="phone"><div class="phone-screen"><Image src={p.mobile.image} alt={p.mobile.alt} widths={[240, 420]} sizes="210px" format="webp" quality={80} loading="lazy" decoding="async" /></div></div></div>
            </div>
          </div>
        </section>
      )}

      <div class="project-cta">
        <h2 data-m="mask"><span class="line-mask"><span>See it <span class="serif">live.</span></span></span></h2>
        <div data-m="stagger">
          <a class="button button-primary" href={p.live} target="_blank" rel="noopener noreferrer" data-magnetic>{p.flagship ? 'Visit Tempest Archive' : `Open ${p.name}`} <Icon class="button-arrow" /></a>
          {p.source && <a class="text-link" href={p.source} target="_blank" rel="noopener noreferrer"><Icon name="github" /> View source</a>}
        </div>
      </div>
      <nav class="project-next" aria-label="Next project">
        <span class="mono">Next project</span>
        <a href={`/projects/${next.slug}`}>{next.name} <Icon /></a>
      </nav>
    </div>
  </article>
</Layout>
