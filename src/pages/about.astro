---
import Layout from '../layouts/Layout.astro';
import Experience from '../components/Experience.astro';
import Icon from '../components/Icon.astro';
import TechStrip from '../components/TechStrip.astro';
import SectionIndex from '../components/SectionIndex.astro';
import { getProject } from '../data/projects';
import { SITE } from '../site.config';

const tempest = getProject('tempest-archive')!;
const quire = getProject('quire')!;
const kilo = getProject('kilo')!;
const folio = getProject('folio')!;
const transmute = getProject('transmute')!;
const signal = getProject('signal')!;

const builds = [
  { id: 'frontend', n: '01', name: 'Frontend', voice: 'tight', title: 'Interfaces that hold up.', body: 'React and Next.js, TypeScript when a project is big enough to want it. I care about the parts people never notice: layout that survives long strings, keyboard focus that goes where you expect, and no layout shift while fonts load.', examples: [tempest, quire], glyph: 'frontend' },
  { id: 'fullstack', n: '02', name: 'Full stack', voice: 'default', title: 'From the form to the row.', body: 'Laravel and PHP with MySQL on the server side, Supabase when a project wants auth and a hosted database quickly. Tempest Archive is the largest: a linked content model, accounts, and every route prerendered for search.', examples: [tempest], glyph: 'fullstack' },
  { id: 'interaction', n: '03', name: 'UI & interaction', voice: 'serif', title: 'Motion with a reason.', body: 'Interaction should explain something: what changed, where it went, what is possible now. I build it with CSS and small amounts of TypeScript first, and reach for a library only when it earns its weight.', examples: [tempest, kilo], glyph: 'interaction' },
  { id: 'tools', n: '04', name: 'Web tools', voice: 'mono', title: 'One job, done properly.', body: 'Five browser applications that do real work locally: PDF operations, image compression, Markdown to PDF, file conversion, QR codes and barcodes. No uploads, no accounts.', examples: [quire, kilo, folio, transmute, signal], glyph: 'tools' },
  { id: 'experiments', n: '05', name: 'Experiments', voice: 'wide', title: 'Small studies.', body: 'The wire sculpture on the home page is one: deterministic geometry rendered on the server, with three shapes that blend on scroll and tilt with the pointer. This site itself is another - every section enters differently, on purpose.', examples: [], glyph: 'experiments' },
];

const flow = [
  { id: 'idea', name: 'Idea', title: 'Start with a real problem.', text: 'A tool I wanted, a site that did not exist yet, a thing a friend kept asking for. If I would not use it, I do not build it.', tags: ['useful products', 'scope'] },
  { id: 'design', name: 'Design', title: 'Decide what it feels like.', text: 'Type, rhythm and hierarchy before colour. Mobile layouts drawn separately, not squeezed from desktop. Motion planned as part of the design, not added after.', tags: ['clean design', 'responsive first'] },
  { id: 'build', name: 'Build', title: 'Write code someone can read.', text: 'Small components, honest names, no clever abstractions until the third repetition. Data models get the most thought; they are the hardest thing to change later.', tags: ['maintainable code', 'data model'] },
  { id: 'polish', name: 'Polish', title: 'Sweat the last five percent.', text: 'Focus states, reduced motion, slow connections, long names, empty states. Performance measured, not assumed. This is where a project starts to feel finished.', tags: ['interaction details', 'performance'] },
  { id: 'ship', name: 'Ship', title: 'Put it on a real domain.', text: 'Everything here is deployed and public. Shipping is how you find out what was actually wrong, and unshipped work helps nobody.', tags: ['actually shipping'] },
];

const source = [
  { name: 'Portfolio-setup', note: 'Five browser tools: file converter, PDF toolkit, image compressor, QR generator, Markdown to PDF.', lang: 'JavaScript', href: SITE.projectsRepository },
  { name: '05-markdown-to-pdf', note: 'QUIRE - editor, preview and PDF engine.', lang: 'React', href: quire.source! },
  { name: '03-image-compressor', note: 'Smaller - Canvas-based conversion, resizing and compression in one HTML page.', lang: 'JavaScript', href: kilo.source! },
  { name: '02-pdf-toolkit', note: 'Folio - pdf-lib and pdf.js operations.', lang: 'React', href: folio.source! },
  { name: '01-file-converter', note: 'Transmute - images, DOCX and tabular data, converted locally.', lang: 'React', href: transmute.source! },
  { name: '04-qr-generator', note: 'SIGNAL - QR codes with tested escaping, nine barcode symbologies.', lang: 'React', href: signal.source! },
];

const description = `${SITE.fullName} (Gio) is a React and full-stack web developer building Tempest Archive and a set of focused browser tools. How I work, what I build, and the stack behind it.`;
const schema = [{ "@type": "ProfilePage", "@id": `${SITE.url}/about#page`, name: "About Gio", url: `${SITE.url}/about`, mainEntity: { "@type": "Person", name: SITE.fullName, alternateName: SITE.author, jobTitle: SITE.role, url: SITE.url, sameAs: [SITE.socials.github], knowsLanguage: SITE.languages.map(language => language.code), knowsAbout: ['React', 'Next.js', 'TypeScript', 'Laravel', 'PHP', 'MySQL', 'Supabase'] } }];
---
<Layout title="About" description={description} page="about" schema={schema} image="/og-about.png">
  <section class="page-hero shell" aria-labelledby="about-heading">
    <p class="eyebrow" data-m="slide"><span class="section-index">About</span> Gio</p>
    <h1 id="about-heading" data-m="mask" data-velocity><span class="line-mask"><span style="--i:0">I build things</span></span><span class="line-mask"><span class="serif" style="--i:1">for the web.</span></span></h1>
    <div class="about-name" data-m="stagger" style="--delay:300ms">
      <strong>{SITE.fullName}</strong>
      <span class="mono">{SITE.role}</span>
    </div>
    <p class="page-lead" data-m="clip" style="--delay:380ms">Mostly React, increasingly the whole stack. I like a small idea executed carefully more than a big idea executed loosely - and I like shipping it to a real domain even more.</p>
    <TechStrip items={['React', 'Next.js', 'TypeScript', 'JavaScript', 'HTML', 'CSS / SCSS', 'MUI', 'Laravel', 'PHP', 'MySQL', 'Supabase', 'Git / GitHub', 'Vercel']} label="Things I work with" delay={500} />
    <span class="page-rule" data-m="draw" aria-hidden="true"></span>
  </section>

  <Experience />

  <!-- What I build -->
  <section class="shell section-pad" aria-labelledby="builds-title">
    <div class="section-topline"><p class="eyebrow"><SectionIndex n="01" /> What I build</p><span class="mono subtle" data-m="slide" data-from="right">Pick one.</span></div>
    <div class="section-heading"><h2 id="builds-title" data-m="mask"><span class="line-mask"><span style="--i:0">Five kinds</span></span><span class="line-mask"><span class="serif" style="--i:1">of making.</span></span></h2><p data-m="clip" style="--delay:200ms">Each one changes what the work<br />looks and sounds like.</p></div>
    <div class="about-tabs" data-tabs>
      <div class="tab-list" role="tablist" aria-label="What I build">
        {builds.map((b, i) => <button type="button" class="tab-btn" role="tab" id={`tab-${b.id}`} aria-selected={i === 0 ? 'true' : 'false'} aria-controls={`panel-${b.id}`} tabindex={i === 0 ? 0 : -1} data-m="slide" style={`--delay:${i * 60}ms`}><span class="mono">{b.n}</span><span class="tab-name">{b.name}</span><span class="tab-count mono">{b.examples.length ? `${b.examples.length} shipped` : 'ongoing'}</span></button>)}
      </div>
      <div class="tab-panels">
        {builds.map((b, i) => (
          <div class="tab-panel" role="tabpanel" id={`panel-${b.id}`} aria-labelledby={`tab-${b.id}`} data-voice={b.voice} hidden={i !== 0}>
            <h3>{b.title}</h3>
            <div class="tab-body">
              <p>{b.body}</p>
              <svg class="tab-glyph" viewBox="0 0 100 100" aria-hidden="true">
                {b.glyph === 'frontend' && <><rect class="dim" x="10" y="16" width="80" height="68" rx="3" pathLength="1" style="--i:0" /><path d="M10 30h80" pathLength="1" style="--i:1" /><path d="M22 46h30M22 58h44M22 70h20" pathLength="1" style="--i:2" /></>}
                {b.glyph === 'fullstack' && <><rect class="dim" x="14" y="12" width="72" height="22" rx="3" pathLength="1" style="--i:0" /><rect class="dim" x="14" y="66" width="72" height="22" rx="3" pathLength="1" style="--i:1" /><path d="M50 34v32M38 50h24" pathLength="1" style="--i:2" /><circle cx="50" cy="50" r="6" pathLength="1" style="--i:3" /></>}
                {b.glyph === 'interaction' && <><path class="dim" d="M14 70c18-40 54-40 72 0" pathLength="1" style="--i:0" /><path d="M14 70c18-24 54-24 72 0" pathLength="1" style="--i:1" /><circle cx="50" cy="52" r="3" pathLength="1" style="--i:2" /><path d="M50 52 62 40" pathLength="1" style="--i:3" /></>}
                {b.glyph === 'tools' && <><rect class="dim" x="12" y="24" width="76" height="52" rx="3" pathLength="1" style="--i:0" /><path d="M28 50h44" pathLength="1" style="--i:1" /><path d="M60 40 72 50 60 60" pathLength="1" style="--i:2" /></>}
                {b.glyph === 'experiments' && <>{Array.from({length: 7}, (_, k) => <ellipse class={k % 2 ? 'dim' : undefined} cx="50" cy="50" rx={38 - k * 3} ry={14 + k * 3} transform={`rotate(${-30 + k * 10} 50 50)`} pathLength="1" style={`--i:${k}`} />)}</>}
              </svg>
            </div>
            <div class="tab-examples">
              {b.examples.length ? b.examples.map((p, k) => <a href={`/projects/${p.slug}`} style={`--i:${k}`}><span class="mono">{String(k + 1).padStart(2, '0')}</span>{p.name}</a>) : <a href="/#home" style="--i:0"><span class="mono">01</span>The sculpture on the home page</a>}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- How I build -->
  <section class="shell section-pad" aria-labelledby="flow-title" style="padding-top:0">
    <div class="section-topline"><p class="eyebrow"><SectionIndex n="02" /> How I build</p><span class="mono subtle" data-m="slide" data-from="right">Idea to shipped.</span></div>
    <div class="section-heading"><h2 id="flow-title" data-m="mask"><span class="line-mask"><span style="--i:0">A short path,</span></span><span class="line-mask"><span class="serif" style="--i:1">walked carefully.</span></span></h2><p data-m="clip" style="--delay:200ms">Five steps. The last one<br />is the one most people skip.</p></div>
    <!-- Pinned: the step list stays while each step's explanation scrolls past and lights it. -->
    <div class="story story-flow" data-story>
      <div class="story-visual">
        <span class="story-progress" aria-hidden="true"><i></i></span>
        <ol class="flow-steps" aria-label="How I build">
          {flow.map((s, i) => <li class:list={['flow-step', {'is-active': i === 0}]} data-screen={i}><a href={`#flow-${s.id}`}><span class="mono">0{i + 1}</span><span class="flow-name">{s.name}</span></a></li>)}
        </ol>
        <p class="story-meta mono" aria-live="polite"><span class="story-n" data-story-n>01</span><span class="subtle"> / 0{flow.length} · </span><span data-story-label>{flow[0].name}</span></p>
      </div>
      <ol class="story-chapters">
        {flow.map((s, i) => (
          <li class:list={['story-chapter', {'is-active': i === 0}]} id={`flow-${s.id}`} data-chapter={i} data-caption={s.name}>
            <span class="mono story-chapter-n">0{i + 1}</span>
            <h3 set:html={`${s.title.split(' ').slice(0, -1).join(' ')} <span class="serif">${s.title.split(' ').at(-1)}</span>`} />
            <p>{s.text}</p>
            <ul class="story-tags mono" aria-label="Cares about">{s.tags.map((t, k) => <li style={`--i:${k}`}>{t}</li>)}</ul>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Real work as proof -->
  <section class="shell section-pad" aria-labelledby="proof-title" style="padding-top:0">
    <div class="section-topline"><p class="eyebrow"><SectionIndex n="03" /> In practice</p><span class="mono subtle" data-m="slide" data-from="right">Shown, not claimed.</span></div>
    <div class="section-heading"><h2 id="proof-title" data-m="mask"><span class="line-mask"><span style="--i:0">What each project</span></span><span class="line-mask"><span class="serif" style="--i:1">taught me.</span></span></h2></div>
    <div class="proof">
      {[
        { p: tempest, what: 'Content architecture, spoiler-aware filtering, accounts, and prerendering the 304 URLs in its sitemap for search. The largest thing I have built.' },
        { p: quire, what: 'Laying out a document and writing a real PDF in the browser - searchable text and working links, not a screenshot.' },
        { p: kilo, what: 'Canvas API conversion and compression for a list of images, showing the size saved before you download, in plain JavaScript with no framework.' },
        { p: folio, what: 'A page-level document workflow on pdf-lib and pdf.js: merge, split, compress and convert without anything leaving the tab.' },
        { p: transmute, what: 'Three conversion families behind one drop zone, with the awkward cases (JPG transparency, GIF palettes, PDF page sizes) handled and explained rather than hidden.' },
        { p: signal, what: 'Getting QR codes right: correct payload escaping proven by decoding tests, scannability warnings, and one geometry shared by preview, PNG and SVG.' },
      ].map(({p, what}, i) => (
        <div class="proof-row" data-m="slide" data-from={i % 2 ? 'right' : undefined} style={`--delay:${i * 60}ms`}>
          <h3><a href={`/projects/${p.slug}`}>{p.name}</a><span>{p.type}</span></h3>
          <p>{what}</p>
          <div class="proof-links"><a href={p.live} target="_blank" rel="noopener noreferrer">Live <Icon /></a>{p.source && <a href={p.source} target="_blank" rel="noopener noreferrer"><Icon name="github" /> Source</a>}</div>
        </div>
      ))}
    </div>
  </section>

  <!-- GitHub -->
  <section class="source-section section-pad" aria-labelledby="source-title">
    <div class="shell">
      <div class="section-topline"><p class="eyebrow"><SectionIndex n="04" /> Selected source</p><a class="mono subtle" href={SITE.socials.github} target="_blank" rel="noopener noreferrer" data-m="slide" data-from="right">github.com/geopero123</a></div>
      <div class="section-heading"><h2 id="source-title" data-m="mask"><span class="line-mask"><span style="--i:0">Read the</span></span><span class="line-mask"><span class="serif" style="--i:1">source.</span></span></h2><p data-m="clip" style="--delay:200ms">The tools are public. Tempest Archive's<br />code is not, but the site is.</p></div>
      <div class="source-list">
        {source.map((s, i) => <a class="source-row" href={s.href} target="_blank" rel="noopener noreferrer" data-m="slide" style={`--delay:${i * 60}ms`}><span><b>{s.name}<span class="mono">{s.lang}</span></b><small>{s.note}</small></span><span class="go"><Icon /></span></a>)}
      </div>
      <p class="source-cta mono" data-m="clip"><span class="subtle">$</span> <a class="typed" href={SITE.socials.github} target="_blank" rel="noopener noreferrer">gh repo list geopero123</a></p>
    </div>
  </section>

  <section class="shell" aria-label="Get in touch">
    <div class="project-cta">
      <h2 data-m="mask"><span class="line-mask"><span>Want to work together?</span></span></h2>
      <div data-m="stagger"><a class="button button-primary" href="/#contact" data-magnetic>Get in touch <Icon class="button-arrow" /></a>{SITE.resume && <a class="text-link" href={SITE.resume} target="_blank" rel="noopener">Résumé (PDF) <Icon /></a>}<a class="text-link" href="/#projects">See the work <Icon /></a></div>
    </div>
  </section>
</Layout>
<script>
  function initTabs() {
    const root = document.querySelector<HTMLElement>('[data-tabs]');
    if (!root || root.dataset.ready) return;
    root.dataset.ready = '1';
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const panels = [...root.querySelectorAll<HTMLElement>('[role="tabpanel"]')];
    const select = (tab: HTMLButtonElement) => {
      tabs.forEach(t => { const on = t === tab; t.setAttribute('aria-selected', String(on)); t.tabIndex = on ? 0 : -1; });
      panels.forEach(p => {
        const on = p.id === tab.getAttribute('aria-controls');
        p.hidden = !on; p.classList.remove('is-entering');
        if (on) { void p.offsetWidth; p.classList.add('is-entering'); }
      });
    };
    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => select(tab));
      tab.addEventListener('pointerenter', () => { if (matchMedia('(hover: hover)').matches) select(tab); });
      tab.addEventListener('keydown', e => {
        const dir = e.key === 'ArrowDown' || e.key === 'ArrowRight' ? 1 : e.key === 'ArrowUp' || e.key === 'ArrowLeft' ? -1 : 0;
        if (!dir) return; e.preventDefault();
        const next = tabs[(i + dir + tabs.length) % tabs.length]; next.focus(); select(next);
      });
    });
  }
  const init = () => { initTabs(); };
  init();
  document.addEventListener('astro:page-load', init);
</script>
